+// PS5LM: the context for the next input copy or view of a split graph. They are tensor headers only (no_alloc).
+// Upstream reserves one context for one split per graph node with GGML_SCHED_MAX_SPLIT_INPUTS inputs each,
+// ~20 KB a node: 523 MiB at llama.cpp's 27,232-node graph for Qwen3.5 at -ub 256, while that graph on one GPU
+// has 2 splits and 10 inputs. On the PS5 every byte a title allocates is backed at once, so it was real memory.
+// Here a context that is full gets a next one twice its size; ggml_backend_sched_split_graph empties them all
+// and keeps them for the next graph. Tensors never move, so no pointer into a context goes stale.
+static struct ggml_context * ggml_backend_sched_ctx(ggml_backend_sched_t sched) {
+    struct ggml_context * ctx = sched->ctxs[sched->cur_ctx];
+    if (ggml_used_mem(ctx) + ggml_tensor_overhead() <= ggml_get_mem_size(ctx)) {
+        return ctx;
+    }
+    const int next = sched->cur_ctx + 1;
+    GGML_ASSERT(next < GGML_SCHED_MAX_CTXS);
+    if (next == sched->n_ctxs) {
+        struct ggml_init_params params = {
+            /* .mem_size   = */ ((size_t) GGML_SCHED_CTX_TENSORS << next) * ggml_tensor_overhead(),
+            /* .mem_buffer = */ NULL,
+            /* .no_alloc   = */ true
+        };
+        sched->ctxs[next] = ggml_init(params);
+        if (sched->ctxs[next] == NULL) {
+            GGML_ABORT("%s: failed to initialize context\n", __func__);
+        }
+        sched->n_ctxs++;
+        GGML_LOG_DEBUG("%s: scheduler context %d for %zu tensors\n", __func__, next, (size_t) GGML_SCHED_CTX_TENSORS << next);
+    }
+    sched->cur_ctx = next;
+    return sched->ctxs[next];
+}
+
+// PS5LM: the backend ids of the graph copy's nodes and leafs, and of the previous graph's, hold at least n entries.
+// Upstream sizes them for one split per node too (graph_size*61 entries each). New entries are 0, as calloc left
+// the entries upstream never wrote; ggml_backend_sched_alloc_splits compares the two only below the copy's size.
+static void ggml_backend_sched_ids_grow(ggml_backend_sched_t sched, int n) {
+    int ** arrays[] = { &sched->node_backend_ids, &sched->leaf_backend_ids,
+                        &sched->prev_node_backend_ids, &sched->prev_leaf_backend_ids };
+    for (int ** a : arrays) {
+        int * pnew = (int *) realloc(*a, (size_t) n * sizeof(int));
+        if (pnew == NULL) {
+            GGML_LOG_ERROR("%s: failed to allocate %zu bytes\n", __func__, (size_t) n * sizeof(int));
+            GGML_ABORT("failed to grow the scheduler's backend ids");
+        }
+        memset(pnew + sched->ids_capacity, 0, (size_t) (n - sched->ids_capacity) * sizeof(int));
+        *a = pnew;
+    }
+    sched->ids_capacity = n;
+}
